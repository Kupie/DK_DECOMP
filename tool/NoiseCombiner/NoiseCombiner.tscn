[sub_resource type="Shader" id="Shader_o0nbg"]
code = "// Noise combiner
shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D noise_1 : repeat_enable, hint_default_black;
uniform vec2 noise_1_uv = vec2(1.0);
uniform sampler2D noise_2 : repeat_enable, hint_default_black;
uniform vec2 noise_2_uv = vec2(1.0);
uniform sampler2D noise_3 : repeat_enable, hint_default_black;
uniform vec2 noise_3_uv = vec2(1.0);

void fragment() {
	vec3 noise_1_t = texture(noise_1, UV*noise_1_uv).rgb;
	vec3 noise_2_t = texture(noise_2, UV*noise_2_uv).rgb;
	vec3 noise_3_t = texture(noise_3, UV*noise_3_uv).rgb;
	
	COLOR.rgb = vec3(noise_1_t.r, noise_2_t.r, noise_3_t.r);
	COLOR.a = 1.0;
}"

