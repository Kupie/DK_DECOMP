text = "v1.1"
label_settings = ExtResource("7")
horizontal_alignment = 1

[node name="Label74" type="Label" parent="Canvas/PatchNotesPanel/VBoxContainer/ScrollContainer/VBoxContainer"]
layout_mode = 2
text = "- fixed issues where reloadng a savegame would crash related to shield and mineral tree. If you still experience that, please send us the crashing savegame, so we can debug it.
- added controller vibration, strength adjustable in the options
- added font for leaderboard that supports non latin characters in player names
- improved cheat detection for leaderboards
- fixed UI not being responsive to joystick anymore, if alternative key mapping was applied"
autowrap_mode = 3

[node name="Label75" type="Label" parent="Canvas/PatchNotesPanel/VBoxContainer/ScrollContainer/VBoxContainer"]
texture_filter = 4
layout_mode = 2
theme_override_fonts/font = ExtResource("11")
text = "- fixed newly unlocked pet or map size not persisting immediately
- fixed keeping a gadget not working when the run was started with a kept gadget
- changed run modifiers to be checkboxes instead of buttons
- improved sounds for beast and ticks
- fixed snow being misplaced in world 3
- fixed raw fury splash screen for 21:9 aspect ratio"
label_settings = ExtResource("12")
autowrap_mode = 3

