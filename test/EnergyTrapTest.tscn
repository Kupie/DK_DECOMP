script/source = "extends Node2D

func _ready():
	randomize()
	Data.apply(\"spire.stuntrapradius\", 60)
	Data.apply(\"spire.stuntrapabsorption\", 1)
	Data.apply(\"spire.stuntrapduration\", 999)
	Data.apply(\"spire.stunmonsters\", 1)
	Style.init(self)
	$Energytrap.start(200)
	_on_PaletteTimer_timeout()


func _on_PaletteTimer_timeout():
	var palettes:Array = Data.gameProperties.get(\"palettes.world\" + str(randi() % 5 + 1))
	Style.setPalette(str(palettes[randi()%palettes.size()]))
"

