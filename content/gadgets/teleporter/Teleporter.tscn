[sub_resource type="Shader" id="63"]
code = "shader_type canvas_item;
render_mode unshaded, blend_add;

uniform sampler2D noise : repeat_enable;
uniform sampler2D palette;
const float start_r = 0.5 / float(32);
const float start_b = 0.5 / float(12);

void fragment() {
	float noise_pos = texture(noise, vec2(round(TIME*0.01)/0.1 - round(fract(TIME*0.3)*40.0)/40.0, 0.0)).r;
	vec2 uv = vec2(UV.x - noise_pos*20.0, UV.y*sign(noise_pos-0.5));
	vec4 input = texture(TEXTURE, uv);
	vec4 output = texture(palette, vec2(start_r + input.r, start_b+input.b));
	output.a = input.a;
	COLOR = output;
}"

