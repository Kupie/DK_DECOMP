[sub_resource type="Shader" id="1"]
code = "shader_type canvas_item;
render_mode blend_add;

uniform sampler2D palette;
uniform sampler2D remap_gradient : source_color;
const float start_r = 0.5 / float(32);
const float start_b = 0.5 / float(12);

varying flat vec4 modulate;
void vertex() {
    modulate = COLOR;
}

void fragment() {
	vec4 color = texture(TEXTURE, UV);
	vec3 tex = clamp(color.rgb/color.a, 0., 10.);
	float t = fract(TIME*0.5)*3.1416*2.0;
	float t2 = fract(TIME*0.7)*3.1416*2.0;
	vec4 input = texture(remap_gradient, vec2(fract(tex.r+TIME*0.6)+(0.1*sin(t))+(0.05*cos(t2)), 0.0));
//	input.a = color.a;
	vec4 output = texture(palette, vec2(start_r + input.r, start_b+input.b));
	output.a = color.a * input.a;
	COLOR = output * modulate;
}"

