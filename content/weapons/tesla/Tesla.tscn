[sub_resource type="Shader" id="142"]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform sampler2D grad : source_color;
uniform vec2 dir;
uniform vec2 uv_mod = vec2(1.0);
uniform float time_offset = 0.0;

void fragment() {
	float tex = texture(TEXTURE, UV*uv_mod).r;
	vec2 t = vec2(2.0*TIME+time_offset, 2.0*TIME+time_offset)*dir*uv_mod;
	vec2 uv = vec2(UV.y, UV.x)+t*uv_mod;
	float f = texture(grad, fract(uv)).r;
	COLOR.a = f*tex;
}"

