[sub_resource type="Shader" id="7"]
code = "shader_type canvas_item;

uniform sampler2D noise_tex : source_color, repeat_enable;
uniform sampler2D ends_tex : source_color;
uniform float disappear = 0.0;
uniform float length_factor = 1.0;

void fragment(){
	vec4 noise = texture(noise_tex, UV*vec2(length_factor, 1.0));
	vec4 tex = texture(TEXTURE, UV);
	COLOR.a = tex.a * mix(1.0, clamp((noise.r-disappear)*4.0, 0.0, 1.0), min(disappear*10.0, 1.0)) * texture(ends_tex, UV).r;
}
"

