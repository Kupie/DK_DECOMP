[gd_resource type="Shader" format=3 uid="uid://b0pi2ieo3pfw7"]

[resource]
code = "shader_type spatial;
render_mode unshaded;

uniform sampler2D matcap : source_color;
uniform float metalness : hint_range(0.0,1.0) = 1.0;
uniform vec4 color : source_color = vec4(1.0);
uniform float glow_power = 0.0;
uniform vec4 glow_color : source_color = vec4(1.0);

void fragment() {
	vec2 matcap_uv = (NORMAL.xy * vec2(0.5, -0.5) + vec2(0.5, 0.5));
	ALBEDO = color.rgb;
	ALBEDO *= mix(vec3(1.0), texture(matcap, matcap_uv).rgb, metalness);
	float dist_fade = smoothstep(40.0, 38.0, -VERTEX.z);
	ALBEDO *= clamp(dist_fade, 0.0, 1.0);
	ALBEDO += mix(vec3(0.0), glow_color.rgb*clamp(dist_fade, 0.3, 1.0), glow_power);
}"
