[sub_resource type="Shader" id="Shader_oesr5"]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform float progress = 0.5;
uniform vec4 color : source_color;
uniform sampler2D noise : source_color, repeat_enable;

void fragment() {
	vec4 tex = texture(TEXTURE, UV);
	vec4 f = color;
	vec2 dist = UV - vec2(0.5);
	float d = dot(dist,dist)*4.0;
	d += texture(noise, UV+TIME*2.0).r*0.6 * pow(d, 0.3);
	f.a = tex.r * clamp(smoothstep(progress, progress+0.1, abs(1.0-d)), 0.0, 1.0) * clamp(smoothstep(progress+0.9, progress+0.6, abs(1.0-d)), 0.0, 1.0);
	f.a = smoothstep(0.0, 0.8, f.a);
	COLOR = f;
}"

