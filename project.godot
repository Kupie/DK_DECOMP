; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

_custom_features="steam,disable_mods"

[application]

config/name="Dome Keeper"
config/tags=PackedStringArray("bippinbits")
run/main_scene="res://game/Game.tscn"
config/features=PackedStringArray("4.3")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://Load.png"
boot_splash/use_filter=false
config/icon="res://icon.png"

[autoload]

ModLoaderStore="*res://addons/mod_loader/mod_loader_store.gd"
ModLoader="*res://addons/mod_loader/mod_loader.gd"
CONST="*res://systems/Const.gd"
CheatDetection="*res://systems/cheats/CheatDetection.tscn"
Backend="*res://systems/telemetry/Backend.tscn"
GameWorld="*res://game/GameWorld.tscn"
SaveGame="*res://game/SaveGame.gd"
InputSystem="*res://systems/input/InputSystem.tscn"
Audio="*res://systems/audio/Audio.tscn"
StageManager="*res://stages/manager/StageManager.tscn"
Options="*res://systems/options/Options.tscn"
Lobby="*res://systems/network/Lobby.gd"
Network="*res://systems/network/Network.gd"
Logger="*res://systems/logger/Logger.tscn"
Level="*res://stages/level/Level.tscn"
Data="*res://systems/data/Data.tscn"
Style="*res://systems/style/Style.tscn"
Platform="*res://systems/platform/Platform.gd"
Achievements="*res://systems/achievements/Achievements.tscn"
Recorder="*res://systems/recorder/Recorder.tscn"
Keepers="*res://game/Keepers.gd"
Profiling="*res://systems/Profiling.gd"
Discovery="*res://systems/network/Discovery.gd"
BuildCustomization="*res://systems/build-customization/BuildCustomization.gd"
DevTools="*res://addons/dome_editor_ext/dev_tools/dev_tools.tscn"
Proximiter="*res://systems/proximiter/proximiter.tscn"
FontScaler="*res://systems/style/FontScaler.gd"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_signal=0
gdscript/warnings/shadowed_variable=false
gdscript/warnings/incompatible_ternary=0
gdscript/warnings/return_value_discarded=false
gdscript/warnings/integer_division=false
gdscript/warnings/narrowing_conversion=false
gdscript/warnings/confusable_local_declaration=0
gdscript/warnings/native_method_override=0
gdscript/warnings/unused_argument=false
gdscript/warnings/variable_conflicts_function=false
gdscript/warnings/function_conflicts_variable=false
gdscript/warnings/function_conflicts_constant=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=false

[editor]

script/search_in_file_extensions=PackedStringArray("gd", "gdshader", "tscn")
run/main_run_args=" --resolution 1920x1080"

[editor_plugins]

enabled=PackedStringArray("res://addons/dome_editor_ext/plugin.cfg", "res://addons/exqueezite_data/plugin.cfg")

[global_group]

unstyled="nodes that don't want to be palette swapped"
lostL=""
splitscreen_scalable_font="text nodes scaled by FontScaler while playing in live splitscreen"

[importer_defaults]

texture={
"compress/bptc_ldr": 0,
"compress/hdr_mode": 0,
"compress/lossy_quality": 0.7,
"compress/mode": 0,
"compress/normal_map": 0,
"detect_3d": true,
"flags/anisotropic": false,
"flags/filter": false,
"flags/mipmaps": false,
"flags/repeat": 0,
"flags/srgb": 2,
"process/HDR_as_SRGB": false,
"process/fix_alpha_border": true,
"process/invert_color": false,
"process/premult_alpha": false,
"size_limit": 0,
"stream": false,
"svg/scale": 1.0
}
ogg_vorbis={
"loop": false,
"loop_offset": 0
}

