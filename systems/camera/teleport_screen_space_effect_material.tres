[sub_resource type="Shader" id="Shader_251sm"]
code = "shader_type canvas_item;
uniform sampler2D SCREEN_TEXTURE : hint_screen_texture, filter_linear_mipmap;

uniform float strength = 0.01;
uniform float speed = 1.0;
uniform sampler2D noise : source_color, repeat_enable;
uniform vec4 color : source_color;
uniform float fade_value = 0.0;

uniform float vignette_intensity = 0.4;
uniform float vignette_opacity : hint_range(0.0, 1.0) = 0.5;
uniform vec4 vignette_rgb : source_color = vec4(0.0, 0.0, 0.0, 1.0);

float vignette(vec2 uv){
	uv *= 1.0 - uv.xy;
	float vignette = uv.x * uv.y * 15.0;
	return pow(vignette, vignette_intensity * vignette_opacity);
}

void fragment(){
	//vec3 screen_tex = mix(texture(SCREEN_TEXTURE, SCREEN_UV), vec4(0.0), fade_value).rgb;
	float mixed_strength = mix(0.0, strength, vignette(SCREEN_UV));
	float h_noise = texture(noise, vec2(SCREEN_UV.x, (fract(0.02*TIME*speed))+SCREEN_UV.y*0.01)).r;
	
	vec2 noised_screen_uv = SCREEN_UV + vec2(step(0.65, h_noise), 0.0) * 0.004 * mixed_strength;
	vec3 current_color = texture(SCREEN_TEXTURE, noised_screen_uv).rgb;
	vec3 right_color = texture(SCREEN_TEXTURE, SCREEN_UV + vec2(SCREEN_PIXEL_SIZE.x, 0)).rgb;
	float r_distance = length(current_color - right_color);
	float b_distance = 0.0;
	for (float i = 0.0; i <= 8.0; i++) {
		vec3 bottom_color = texture(SCREEN_TEXTURE, SCREEN_UV - vec2(0, SCREEN_PIXEL_SIZE.y * (1.0 + 2.0*mixed_strength) * -speed)*i).rgb;
		b_distance += length(current_color - bottom_color) * abs(1.0-float(i)/8.0);
	}
	float dist = (r_distance+b_distance);
	current_color = mix(current_color, vec3(0.0), fade_value).rgb;
	current_color += (step(0.65, h_noise)*0.07 + mix(dist, 0.0, fade_value)) * (color.rgb*0.4) * mixed_strength;
	COLOR = vec4(current_color + color.rgb*0.04, 1.0);
	COLOR.rgb = mix(vignette_rgb.rgb, COLOR.rgb, clamp(vignette(SCREEN_UV), 0.0, 1.0));
	COLOR.rgb = mix(texture(SCREEN_TEXTURE, SCREEN_UV).rgb, COLOR.rgb, strength);
}"

